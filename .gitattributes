# Normalize line endings. This repo is authored on Windows but its CI runs on
# Linux and its plugins ship scripts that users execute — a CRLF shebang line
# fails with "bad interpreter" on macOS and Linux.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
